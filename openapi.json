                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "FEATURE_DISABLED or MERCHANT_SCOPE"
          }
        }
      }
    },
    "/v2/internal/subscriptions/price": {
      "post": {
        "summary": "Change what the next renewals cost (also at 2Checkout)",
        "operationId": "setSubscriptionPrice",
        "security": [
          {
            "merchantKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "amountMinor": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "amountMinor"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "FEATURE_DISABLED or MERCHANT_SCOPE"
          }
        }
      }
    },
    "/v2/twocheckout/ipn": {
      "post": {
        "summary": "2Checkout IPN: signed order, renewal, refund and chargeback notification",
        "operationId": "twocheckoutIPN",
        "description": "HMAC-SHA256 signed by 2Checkout; answered with the signed read receipt. Not for merchants to call.",
        "responses": {
          "200": {
            "description": "Acknowledged"
          },
          "202": {
            "description": "Acknowledged, nothing to do"
          },
          "401": {
            "description": "PROVIDER_SIGNATURE_INVALID"
          }
        }
      },
      "get": {
        "summary": "2Checkout IPN endpoint liveness (2Checkout checks a URL with a GET when it is saved)",
        "operationId": "twocheckoutIPNLiveness",
        "responses": {
          "200": {
            "description": "{ok, endpoint}"
          }
        }
      }
    },
    "/v2/twocheckout/lcn": {
      "post": {
        "summary": "2Checkout LCN: signed subscription change notification",
        "operationId": "twocheckoutLCN",
        "description": "HMAC-SHA256 signed by 2Checkout; answered with the signed read receipt. Not for merchants to call.",
        "responses": {
          "200": {
            "description": "Acknowledged"
          },
          "202": {
            "description": "Acknowledged, nothing to do"
          },
          "401": {
            "description": "PROVIDER_SIGNATURE_INVALID"
          }
        }
      },
      "get": {
        "summary": "2Checkout LCN endpoint liveness (2Checkout checks a URL with a GET when it is saved)",
        "operationId": "twocheckoutLCNLiveness",
        "responses": {
          "200": {
            "description": "{ok, endpoint}"
          }
        }
      }
    },
    "/v2/internal/merchant/settlement": {
      "get": {
        "summary": "The provider accounts your key has connected (masked); the secret is never returned",
        "operationId": "listSettlementAccounts",
        "responses": {
          "200": {
            "description": "{ accounts: [{ provider, mode: 'own-keys', environment, account, status, connectedAt, verifiedAt }] }"
          },
          "403": {
            "description": "a global key, which has no merchant"
          }
        }
      }
    },
    "/v2/internal/merchant/settlement/{provider}": {
      "put": {
        "summary": "Connect your own provider account so the money lands with you (own keys). Credentials are checked with the provider, sealed, and never returned",
        "operationId": "connectSettlementAccount",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "paypal"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "clientId",
                  "clientSecret"
                ],
                "properties": {
                  "clientId": {
                    "type": "string"
                  },
                  "clientSecret": {
                    "type": "string"
                  },
                  "environment": {
                    "type": "string",
                    "enum": [
                      "sandbox",
                      "production"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ account: { provider, mode, environment, account, status, connectedAt, verifiedAt } }"
          },
          "400": {
            "description": "SETTLEMENT_PROVIDER_UNSUPPORTED or INVALID_REQUEST"
          },
          "403": {
            "description": "LIVE_KEY_REQUIRED (a test key cannot hold an account) or a global key"
          },
          "422": {
            "description": "CREDENTIALS_REJECTED (the provider refused them) or ENVIRONMENT_MISMATCH (sandbox keys on a production Worker, or the reverse)"
          }
        }
      },
      "delete": {
        "summary": "Disconnect the account; later payments settle through the deployment's account again",
        "operationId": "disconnectSettlementAccount",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "paypal"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ disconnected: boolean }"
          }
        }
      }
    },
    "/v2/price-list": {
      "get": {
        "summary": "WavePay's own price list: plans, the usage schedule and the modes (same data as /pricing.json)",
        "operationId": "priceList",
        "responses": {
          "200": {
            "description": "{ currency, plans: [{ id, name, monthlyMinor, annualMinor, includedPayments, sites }], usage: { tiers }, providerFees, modes }"
          }
        }
      }
    },
    "/v2/internal/merchant/usage": {
      "get": {
        "summary": "This month's usage meter for your key: payments, included allowance, usage fee by tier, total due",
        "operationId": "merchantUsage",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2026-10"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ month, plan, payments, includedPayments, nonUsdPayments, usage: { feeMinor, chargedPayments, byTier }, totalDueMinor }"
          },
          "403": {
            "description": "a global key, which has no merchant"
          }
        }
      }
    },
    "/v2/crypto/rails": {
      "get": {
        "summary": "The crypto rails WavePay takes (Bitcoin, Ethereum, Solana, BNB, Litecoin, Dogecoin, Tron, USDT, USDC) and which can be quoted right now",
        "operationId": "cryptoRails",
        "responses": {
          "200": {
            "description": "{ rails: [{ id, symbol, network, address, confirmations, quotable }] }"
          }
        }
      }
    },
    "/v2/internal/crypto/rates": {
      "post": {
        "summary": "Global key: store coin prices in US dollars (a checkout refuses a rate older than ten minutes)",
        "operationId": "cryptoRates",
        "responses": {
          "200": {
            "description": "{ ok, coins }"
          },
          "400": {
            "description": "unknown coin or a price that is not positive"
          }
        }
      }
    },
    "/v2/internal/crypto/pending": {
      "post": {
        "summary": "Global key: open crypto payments with rail, exact base-unit amount and address — what the watcher looks for",
        "operationId": "cryptoPending",
        "responses": {
          "200": {
            "description": "{ payments: [{ reference, rail, baseUnits, address, createdAt }] }"
          }
        }
      }
    },
    "/v2/internal/crypto/settle": {
      "post": {
        "summary": "Global key: settle a payment from a deposit the exchange credited. Re-verified: rail, address, exact amount, and the transaction never settled a payment before",
        "operationId": "cryptoSettle",
        "responses": {
          "200": {
            "description": "the payment's status"
          },
          "422": {
            "description": "PAYMENT_MISMATCH — not the deposit that was asked for"
          },
          "409": {
            "description": "TRANSFER_ALREADY_USED"
          }
        }
      }
    },
    "/v2/internal/merchant/invoices": {
      "get": {
        "summary": "Your usage invoices (month, amount, status)",
        "operationId": "merchantInvoices",
        "responses": {
          "200": {
            "description": "{ invoices: [{ id, month, planId, payments, chargedPayments, amountMinor, status, createdAt, dueAt, paidAt }] }"
          },
          "403": {
            "description": "a global key, which has no merchant"
          }
        }
      }
    },
    "/v2/internal/invoices/run": {
      "post": {
        "summary": "Global key: invoice a month's usage now (default last month); dryRun lists who would be invoiced. Idempotent",
        "operationId": "runInvoices",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "string"
                  },
                  "dryRun": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ month, created: [{ merchantId, invoiceId, amountMinor, emailed }], skipped }"
          }
        }
      }
    },
    "/v2/invoices/{id}/pay/{provider}": {
      "get": {
        "summary": "The emailed pay link for a usage invoice: needs its token (?t=), opens a checkout for the invoice amount and redirects to it",
        "operationId": "payInvoice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "paynow",
                "paypal"
              ]
            }
          },
          {
            "name": "t",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "redirect to the provider's checkout"
          },
          "401": {
            "description": "wrong token"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "merchantKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-wavepay-service-key",
        "description": "mk_live_… / mk_test_… — minted by POST /v2/register, SHA-256 stored, shown once"
      }
    }
  }
}
